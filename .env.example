# ─── Required ─────────────────────────────────────────────────────────────

# The Graph gateway API key. Get one at https://thegraph.com/studio/
GRAPH_API_KEY=

# ─── Optional — database location ─────────────────────────────────────────

# Default: ./tracker.db
# TRACKER_DB=/var/lib/defi-tracker/tracker.db

# ─── Optional — RPC endpoints per chain ───────────────────────────────────
# Adapters fall back to public RPCs if not set; you'll want private ones
# (Alchemy, QuickNode, Ankr, dRPC) for production reliability.

# ALCHEMY_API_KEY=
#   ^ one key covers bsc (bnb-mainnet) and base (base-mainnet): the tracker
#     builds the URLs itself. An explicit *_RPC_URL below still wins.
#     Alchemy does not serve peaq — peaq stays on PEAQ_RPC_URL.
# PEAQ_RPC_URL=
#   ^ peaq JSON-RPC (archive, for history). MachineX event scanning needs it.
# PEAQ_RPC_URL_FALLBACK=
#   ^ optional second provider(s), comma-separated, tried when the primary
#     does not answer. Any chain takes a {CHAIN}_RPC_URL_FALLBACK.
#
# BSC_RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/YOUR_KEY
#   ^ when unset, bsc runs on a public endpoint; set it (or ALCHEMY_API_KEY)
#     once bsc positions are load-bearing.
# ETH_RPC_URL=https://eth.llamarpc.com
# ARB_RPC_URL=https://arb1.arbitrum.io/rpc
# OP_RPC_URL=https://mainnet.optimism.io
# BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
#   ^ the public endpoint throttles the fee-growth calls, so unclaimed fees
#     on Base read as unknown ('—'). Point this at a private JSON-RPC node
#     (Alchemy, QuikNode, Moralis RPC Nodes) to get real unclaimed figures.
#     NB: Moralis's Web3 Data API is REST, not JSON-RPC — it will not work here.
#
#   Size the plan against HOURLY marks, not daily: `defi-tracker mark` runs
#   once an hour, which is ~24x the request volume the old daily cadence
#   implied. A tier chosen against yesterday's usage will be wrong in a month.
#
#   After setting either one, run `defi-tracker rpc-check`: it verifies the
#   endpoint is reachable, is actually the chain you think (a URL in the wrong
#   variable otherwise fails silently), and whether it serves archive state.
# POLYGON_RPC_URL=https://polygon-rpc.com
# AVAX_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# ─── Optional — Slack alerts ──────────────────────────────────────────────
# Incoming webhook URL. Without this, alerts are written to the DB only.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ─── Optional — pricing ───────────────────────────────────────────────────
# CoinGecko demo key: raises the rate limit for prices, venues and depeg reads.
# COINGECKO_API_KEY=

# ─── Optional — scope and desk inputs ─────────────────────────────────────
# Chains the Uniswap V3 adapter registers for ("" disables it). Default: base
# UNISWAP_V3_CHAINS=base
# Mandate limits (a named file that is missing or malformed alerts — it never
# loads as "no limits"). Default: ./policy.toml
# POLICY_FILE=
# Market makers' Coinwatch history, read-only. Default: ~/market-makers/data/history.sqlite3
# COINWATCH_DB=
# Desk content (counterparty terms — kept out of git). Defaults: content/mandate.toml, content/rfq.toml
# MANDATE_FILE=
# RFQ_FILE=
# Links the desk and Slack render (e.g. a hosted mandate proposal and the desk
# page). Unset or empty: the link is left out.
# DESK_PROPOSAL_URL=
# DESK_URL=
# LOG_LEVEL=WARNING
