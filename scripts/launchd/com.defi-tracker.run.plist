<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.defi-tracker.run</string>

    <key>ProgramArguments</key>
    <array>
        <string>/path/to/onchain-monitor/.venv/bin/defi-tracker</string>
        <string>run</string>
        <string>--report</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/onchain-monitor</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>20</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/path/to/onchain-monitor/logs/run.log</string>

    <key>StandardErrorPath</key>
    <string>/path/to/onchain-monitor/logs/run.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
