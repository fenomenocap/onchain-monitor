<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hourly marks. `run` (com.defi-tracker.run) stays twice-daily; this only
  records one mark per position, which is what every Phase 4 metric needs and
  what cannot be backfilled. A pass takes ~1 minute.

  Minute 30, not 0: keeps it clear of `run` at 08:00 and 20:00, which marks too.
  A Minute-only StartCalendarInterval fires every hour; if the machine is
  asleep, launchd coalesces the missed firings into one run on wake.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.defi-tracker.mark</string>

    <key>ProgramArguments</key>
    <array>
        <string>/path/to/onchain-monitor/.venv/bin/defi-tracker</string>
        <string>mark</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/onchain-monitor</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/path/to/onchain-monitor/logs/mark.log</string>

    <key>StandardErrorPath</key>
    <string>/path/to/onchain-monitor/logs/mark.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
